{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "oauth2-proxy",
            "env": [
              {
                "name": "OAUTH2_PROXY_BACKEND_LOGOUT_URL",
                "value": "http://keycloak.keep-lab.svc:8080/realms/core/protocol/openid-connect/logout?id_token_hint={id_token}"
              }
            ]
          }
        ]
      }
    }
  }
}
